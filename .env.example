# Copy to .env for local runs. docker-compose sets these via `environment:`.

APP_ENV=local

# SQLAlchemy URL (driver: psycopg v3)
DATABASE_URL=postgresql+psycopg://drivenow:drivenow@localhost:5432/drivenow

# Message queue
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
ENABLE_MESSAGE_QUEUE=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
